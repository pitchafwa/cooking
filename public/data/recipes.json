0 g noodles"},{"name":"peanut butter","text":"3 tbsp peanut butter"},{"name":"soy sauce","text":"2 tbsp soy sauce"},{"name":"lime","text":"1 lime"},{"name":"garlic","text":"1 clove garlic"},{"name":"green onion","text":"2 green onions"},{"name":"honey","text":"1 tsp honey"}],"steps":["Cook the noodles and drain.","Whisk peanut butter, soy sauce, lime, garlic and honey with a splash of warm water.","Toss with noodles and top with green onion."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-roasted-vegetable-bowl","title":"Roasted Vegetable Bowl","cuisine":"american","minutes":40,"difficulty":"easy","meals":["dinner","lunch"],"vibes":["light-and-fresh","meal-prep"],"diets":["vegetarian","vegan","gluten-free","dairy-free"],"main":"Beans & lentils","servings":2,"rating":4.3,"ingredients":[{"name":"sweet potato","text":"1 sweet potato"},{"name":"chickpeas","text":"1 can chickpeas"},{"name":"broccoli","text":"1 head broccoli"},{"name":"olive oil","text":"2 tbsp olive oil"},{"name":"lemon","text":"1 lemon"},{"name":"rice","text":"cooked rice or quinoa"}],"steps":["Roast cubed sweet potato, chickpeas and broccoli with oil at 210 C for 25 minutes.","Serve over rice with a squeeze of lemon."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-honey-garlic-chicken-thighs","title":"Honey Garlic Chicken Thighs","cuisine":"american","minutes":45,"difficulty":"easy","meals":["dinner"],"vibes":["weeknight","comfort-food"],"diets":["dairy-free"],"main":"Chicken","servings":4,"rating":4.6,"ingredients":[{"name":"chicken thigh","text":"6 chicken thighs"},{"name":"honey","text":"3 tbsp honey"},{"name":"soy sauce","text":"3 tbsp soy sauce"},{"name":"garlic","text":"4 cloves garlic"},{"name":"vegetable oil","text":"1 tbsp oil"}],"steps":["Brown the thighs skin-side down.","Mix honey, soy sauce and garlic; pour over.","Bake at 200 C for 25 minutes, basting once."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-mushroom-omelette","title":"Mushroom Omelette","cuisine":"french","minutes":10,"difficulty":"easy","meals":["breakfast","lunch"],"vibes":["breakfast-in-bed","workday-lunch"],"diets":["vegetarian","gluten-free"],"main":"Eggs","servings":1,"rating":4.3,"ingredients":[{"name":"egg","text":"3 eggs"},{"name":"mushroom","text":"5 mushrooms"},{"name":"butter","text":"1 tbsp butter"},{"name":"cheddar","text":"handful of cheddar"},{"name":"salt","text":"salt"}],"steps":["Sauté sliced mushrooms in butter; set aside.","Pour in beaten eggs, cook until barely set.","Add mushrooms and cheese, fold over."],"source":{"name":"Cooking Hub sample recipe"}}]