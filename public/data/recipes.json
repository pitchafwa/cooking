[{"id":"s-buckwheat-pancakes","title":"Buckwheat Pancakes","cuisine":"american","minutes":25,"difficulty":"medium","meals":["breakfast"],"vibes":["breakfast-in-bed","sunday-morning"],"diets":["vegetarian"],"main":"Grains & baking","servings":4,"rating":4.5,"ingredients":[{"name":"buckwheat flour","text":"1 cup buckwheat flour"},{"name":"flour","text":"1/2 cup all-purpose flour"},{"name":"baking powder","text":"2 tsp baking powder"},{"name":"milk","text":"1 1/4 cups milk"},{"name":"egg","text":"1 egg"},{"name":"butter","text":"2 tbsp melted butter"},{"name":"maple syrup","text":"maple syrup, to serve"},{"name":"salt","text":"1/4 tsp salt"}],"steps":["Whisk both flours, baking powder and salt.","Beat in milk, egg and melted butter until just combined; rest 5 minutes.","Cook 1/4-cup scoops on a buttered pan over medium heat, 2 minutes per side.","Serve stacked with maple syrup."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-fluffy-scrambled-eggs-on-toast","title":"Fluffy Scrambled Eggs on Toast","cuisine":"american","minutes":10,"difficulty":"easy","meals":["breakfast"],"vibes":["breakfast-in-bed","weeknight"],"diets":["vegetarian"],"main":"Grains & baking","servings":2,"rating":4.5,"ingredients":[{"name":"egg","text":"4 eggs"},{"name":"butter","text":"1 tbsp butter"},{"name":"milk","text":"2 tbsp milk"},{"name":"bread","text":"2 slices bread"},{"name":"salt","text":"pinch of salt"},{"name":"black pepper","text":"black pepper"}],"steps":["Whisk eggs with milk and salt.","Melt butter over low heat, add eggs and stir slowly until softly set.","Toast bread and spoon eggs on top."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-banana-oat-pancakes","title":"Banana Oat Pancakes","cuisine":"american","minutes":20,"difficulty":"easy","meals":["breakfast"],"vibes":["breakfast-in-bed","sunday-morning"],"diets":["vegetarian"],"main":"Grains & baking","servings":2,"rating":4.3,"ingredients":[{"name":"banana","text":"2 ripe bananas"},{"name":"oats","text":"1 cup rolled oats"},{"name":"egg","text":"2 eggs"},{"name":"cinnamon","text":"1/2 tsp cinnamon"},{"name":"butter","text":"butter for the pan"}],"steps":["Blend bananas, oats, eggs and cinnamon into a thick batter.","Cook small rounds in a buttered pan 2 minutes per side."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-overnight-oats-with-berries","title":"Overnight Oats with Berries","cuisine":"american","minutes":5,"difficulty":"easy","meals":["breakfast"],"vibes":["weeknight","light-and-fresh","meal-prep"],"diets":["vegetarian"],"main":"Grains & baking","servings":1,"rating":4.2,"ingredients":[{"name":"oats","text":"1/2 cup rolled oats"},{"name":"yogurt","text":"1/3 cup yogurt"},{"name":"milk","text":"1/2 cup milk"},{"name":"honey","text":"1 tsp honey"},{"name":"strawberry","text":"handful of strawberries"}],"steps":["Stir oats, yogurt, milk and honey in a jar.","Chill overnight, then top with sliced strawberries."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-french-toast","title":"French Toast","cuisine":"french","minutes":20,"difficulty":"easy","meals":["breakfast"],"vibes":["breakfast-in-bed","sunday-morning"],"diets":["vegetarian"],"main":"Grains & baking","servings":2,"rating":4.6,"ingredients":[{"name":"bread","text":"4 thick slices bread"},{"name":"egg","text":"2 eggs"},{"name":"milk","text":"1/2 cup milk"},{"name":"cinnamon","text":"1/2 tsp cinnamon"},{"name":"vanilla","text":"1 tsp vanilla"},{"name":"butter","text":"butter for the pan"},{"name":"maple syrup","text":"maple syrup"}],"steps":["Whisk eggs, milk, cinnamon and vanilla in a shallow dish.","Soak bread slices 20 seconds per side.","Fry in butter until golden on both sides; serve with syrup."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-spaghetti-aglio-e-olio","title":"Spaghetti Aglio e Olio","cuisine":"italian","minutes":20,"difficulty":"easy","meals":["dinner"],"vibes":["weeknight","date-night"],"diets":["vegetarian","vegan","dairy-free"],"main":"Pasta","servings":2,"rating":4.6,"ingredients":[{"name":"spaghetti","text":"200 g spaghetti"},{"name":"garlic","text":"5 cloves garlic, sliced"},{"name":"olive oil","text":"1/3 cup olive oil"},{"name":"chili flakes","text":"1/2 tsp chili flakes"},{"name":"parsley","text":"handful of parsley"},{"name":"salt","text":"salt"}],"steps":["Boil spaghetti in salted water until al dente; reserve a cup of pasta water.","Gently warm garlic in olive oil until pale gold.","Toss pasta with the oil, chili and a splash of pasta water.","Finish with parsley."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-tomato-basil-pasta","title":"Tomato Basil Pasta","cuisine":"italian","minutes":25,"difficulty":"easy","meals":["dinner"],"vibes":["weeknight","crowd-pleaser"],"diets":["vegetarian"],"main":"Pasta","servings":3,"rating":4.4,"ingredients":[{"name":"pasta","text":"250 g pasta"},{"name":"canned tomatoes","text":"1 can (400 g) crushed tomatoes"},{"name":"garlic","text":"2 cloves garlic"},{"name":"basil","text":"fresh basil"},{"name":"olive oil","text":"2 tbsp olive oil"},{"name":"parmesan","text":"grated parmesan"},{"name":"salt","text":"salt"}],"steps":["Cook pasta in salted water.","Sauté garlic in oil, add tomatoes and simmer 10 minutes.","Toss with pasta, torn basil and parmesan."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-creamy-mushroom-risotto","title":"Creamy Mushroom Risotto","cuisine":"italian","minutes":50,"difficulty":"medium","meals":["dinner"],"vibes":["date-night","comfort-food"],"diets":["vegetarian","gluten-free"],"main":"Rice & noodles","servings":3,"rating":4.7,"ingredients":[{"name":"arborio rice","text":"1 cup arborio rice"},{"name":"mushroom","text":"250 g mushrooms, sliced"},{"name":"onion","text":"1 small onion"},{"name":"garlic","text":"2 cloves garlic"},{"name":"vegetable broth","text":"4 cups warm vegetable broth"},{"name":"butter","text":"2 tbsp butter"},{"name":"parmesan","text":"1/2 cup parmesan"},{"name":"white wine","text":"1/2 cup white wine"}],"steps":["Brown mushrooms in butter; set aside.","Soften onion and garlic, toast the rice 1 minute, add wine.","Add warm broth a ladle at a time, stirring, for about 25 minutes.","Fold in mushrooms, parmesan and a knob of butter."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-margherita-flatbread","title":"Margherita Flatbread","cuisine":"italian","minutes":30,"difficulty":"easy","meals":["dinner","lunch"],"vibes":["date-night","crowd-pleaser"],"diets":["vegetarian","gluten-free"],"main":"Cheese","servings":2,"rating":4.3,"ingredients":[{"name":"flatbread","text":"2 flatbreads"},{"name":"canned tomatoes","text":"1/2 cup crushed tomatoes"},{"name":"mozzarella","text":"150 g fresh mozzarella"},{"name":"basil","text":"fresh basil"},{"name":"olive oil","text":"drizzle of olive oil"}],"steps":["Heat oven to 230 C.","Spread tomatoes on flatbreads, top with torn mozzarella.","Bake 8-10 minutes until bubbling; finish with basil and oil."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-lemon-garlic-chicken","title":"Lemon Garlic Chicken","cuisine":"american","minutes":35,"difficulty":"medium","meals":["dinner"],"vibes":["weeknight","date-night"],"diets":["gluten-free"],"main":"Chicken","servings":3,"rating":4.5,"ingredients":[{"name":"chicken breast","text":"3 chicken breasts"},{"name":"lemon","text":"1 lemon"},{"name":"garlic","text":"4 cloves garlic"},{"name":"olive oil","text":"2 tbsp olive oil"},{"name":"butter","text":"1 tbsp butter"},{"name":"parsley","text":"chopped parsley"},{"name":"salt","text":"salt"},{"name":"black pepper","text":"pepper"}],"steps":["Season chicken and sear in oil 5 minutes per side.","Add butter, garlic and lemon juice; spoon over chicken until cooked through.","Garnish with parsley."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-chicken-fried-rice","title":"Chicken Fried Rice","cuisine":"chinese","minutes":25,"difficulty":"medium","meals":["dinner","lunch"],"vibes":["weeknight","leftovers-friendly"],"diets":["dairy-free"],"main":"Chicken","servings":3,"rating":4.4,"ingredients":[{"name":"rice","text":"3 cups cooked rice, cold"},{"name":"chicken breast","text":"1 chicken breast, diced"},{"name":"egg","text":"2 eggs"},{"name":"carrot","text":"1 carrot, diced"},{"name":"green onion","text":"3 green onions"},{"name":"soy sauce","text":"3 tbsp soy sauce"},{"name":"sesame oil","text":"1 tsp sesame oil"},{"name":"vegetable oil","text":"2 tbsp vegetable oil"}],"steps":["Stir-fry chicken in oil until cooked; push aside.","Scramble the eggs in the same pan.","Add carrot and rice, tossing on high heat 4 minutes.","Season with soy sauce and sesame oil; top with green onion."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-garlic-ginger-broccoli-stir-fry","title":"Garlic Ginger Broccoli Stir-Fry","cuisine":"chinese","minutes":15,"difficulty":"easy","meals":["dinner","side"],"vibes":["weeknight","light-and-fresh"],"diets":["vegetarian","vegan","dairy-free"],"main":"Vegetables","servings":2,"rating":4.2,"ingredients":[{"name":"broccoli","text":"1 large head broccoli"},{"name":"garlic","text":"3 cloves garlic"},{"name":"ginger","text":"1 tbsp grated ginger"},{"name":"soy sauce","text":"2 tbsp soy sauce"},{"name":"sesame oil","text":"1 tsp sesame oil"},{"name":"vegetable oil","text":"1 tbsp vegetable oil"}],"steps":["Stir-fry broccoli in hot oil 3 minutes.","Add garlic and ginger for 30 seconds.","Splash in soy sauce and sesame oil; serve over rice."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-teriyaki-salmon","title":"Teriyaki Salmon","cuisine":"japanese","minutes":25,"difficulty":"easy","meals":["dinner"],"vibes":["date-night","weeknight"],"diets":["pescatarian","dairy-free"],"main":"Fish & seafood","servings":2,"rating":4.6,"ingredients":[{"name":"salmon","text":"2 salmon fillets"},{"name":"soy sauce","text":"3 tbsp soy sauce"},{"name":"honey","text":"2 tbsp honey"},{"name":"garlic","text":"1 clove garlic"},{"name":"ginger","text":"1 tsp grated ginger"},{"name":"rice","text":"rice, to serve"}],"steps":["Simmer soy sauce, honey, garlic and ginger until syrupy.","Sear salmon skin-side down 4 minutes, flip 2 minutes.","Glaze with sauce and serve over rice."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-black-bean-tacos","title":"Black Bean Tacos","cuisine":"mexican","minutes":20,"difficulty":"easy","meals":["dinner","lunch"],"vibes":["weeknight","crowd-pleaser"],"diets":["vegetarian","vegan","dairy-free"],"main":"Beans & lentils","servings":3,"rating":4.3,"ingredients":[{"name":"black beans","text":"1 can black beans"},{"name":"tortilla","text":"6 small tortillas"},{"name":"avocado","text":"1 avocado"},{"name":"lime","text":"1 lime"},{"name":"cilantro","text":"cilantro"},{"name":"cumin","text":"1 tsp cumin"},{"name":"onion","text":"1/2 red onion"}],"steps":["Warm beans with cumin and a splash of water, mashing lightly.","Warm the tortillas.","Fill with beans, sliced avocado, onion, cilantro and lime."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-chicken-quesadillas","title":"Chicken Quesadillas","cuisine":"mexican","minutes":20,"difficulty":"easy","meals":["dinner","lunch"],"vibes":["weeknight","crowd-pleaser"],"diets":[],"main":"Chicken","servings":2,"rating":4.2,"ingredients":[{"name":"tortilla","text":"4 tortillas"},{"name":"cheddar","text":"1 1/2 cups shredded cheddar"},{"name":"chicken breast","text":"1 cooked chicken breast, shredded"},{"name":"bell pepper","text":"1 bell pepper, sliced"}],"steps":["Layer cheese, chicken and pepper on half of each tortilla and fold.","Toast in a dry pan 2-3 minutes per side until crisp and melted."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-guacamole-and-chips","title":"Guacamole and Chips","cuisine":"mexican","minutes":10,"difficulty":"easy","meals":["snack"],"vibes":["game-night","light-and-fresh"],"diets":["vegetarian","vegan","dairy-free"],"main":"Grains & baking","servings":4,"rating":4.5,"ingredients":[{"name":"avocado","text":"3 ripe avocados"},{"name":