garlic in oil; stir in cumin.","Add lentils and broth; simmer 20 minutes until soft.","Blend part of the soup and finish with lemon juice."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-greek-salad","title":"Greek Salad","cuisine":"greek","minutes":10,"difficulty":"easy","meals":["lunch","salad","side"],"vibes":["workday-lunch","light-and-fresh"],"diets":["vegetarian","gluten-free"],"main":"Cheese","servings":2,"rating":4.4,"ingredients":[{"name":"cucumber","text":"1 cucumber"},{"name":"tomato","text":"3 tomatoes"},{"name":"red onion","text":"1/2 red onion"},{"name":"feta","text":"100 g feta"},{"name":"olives","text":"handful of olives"},{"name":"olive oil","text":"3 tbsp olive oil"},{"name":"red wine vinegar","text":"1 tbsp red wine vinegar"}],"steps":["Chop cucumber, tomato and onion into chunks.","Toss with olives, oil and vinegar; crumble feta on top."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-avocado-toast-with-egg","title":"Avocado Toast with Egg","cuisine":"american","minutes":10,"difficulty":"easy","meals":["breakfast","lunch"],"vibes":["workday-lunch","breakfast-in-bed"],"diets":["vegetarian","dairy-free"],"main":"Grains & baking","servings":1,"rating":4.3,"ingredients":[{"name":"bread","text":"2 slices bread"},{"name":"avocado","text":"1 avocado"},{"name":"egg","text":"2 eggs"},{"name":"lemon","text":"squeeze of lemon"},{"name":"chili flakes","text":"pinch of chili flakes"},{"name":"salt","text":"salt"}],"steps":["Toast bread; mash avocado with lemon and salt.","Fry or poach the eggs.","Pile avocado on toast, top with egg and chili flakes."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-tuna-salad-sandwich","title":"Tuna Salad Sandwich","cuisine":"american","minutes":10,"difficulty":"easy","meals":["lunch"],"vibes":["workday-lunch"],"diets":["pescatarian","dairy-free"],"main":"Fish & seafood","servings":2,"rating":4.0,"ingredients":[{"name":"tuna","text":"1 can tuna"},{"name":"mayonnaise","text":"2 tbsp mayonnaise"},{"name":"celery","text":"1 stalk celery"},{"name":"lemon","text":"squeeze of lemon"},{"name":"bread","text":"4 slices bread"}],"steps":["Flake tuna and mix with mayonnaise, diced celery and lemon.","Spread onto bread and slice."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-caprese-sandwich","title":"Caprese Sandwich","cuisine":"italian","minutes":10,"difficulty":"easy","meals":["lunch"],"vibes":["workday-lunch","light-and-fresh"],"diets":["vegetarian"],"main":"Grains & baking","servings":1,"rating":4.4,"ingredients":[{"name":"bread","text":"1 ciabatta roll"},{"name":"mozzarella","text":"100 g mozzarella"},{"name":"tomato","text":"1 tomato"},{"name":"basil","text":"fresh basil"},{"name":"olive oil","text":"drizzle of olive oil"}],"steps":["Slice the roll and layer mozzarella, tomato and basil.","Drizzle with oil and season."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-classic-grilled-cheese","title":"Classic Grilled Cheese","cuisine":"american","minutes":10,"difficulty":"easy","meals":["lunch","dinner"],"vibes":["workday-lunch","comfort-food"],"diets":["vegetarian"],"main":"Grains & baking","servings":1,"rating":4.5,"ingredients":[{"name":"bread","text":"2 slices bread"},{"name":"cheddar","text":"3 slices cheddar"},{"name":"butter","text":"1 tbsp butter"}],"steps":["Butter the outsides of the bread; fill with cheddar.","Cook in a skillet over medium-low heat until golden and melted, 3 minutes per side."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-baked-potato-soup","title":"Baked Potato Soup","cuisine":"american","minutes":40,"difficulty":"medium","meals":["dinner","soup"],"vibes":["comfort-food"],"diets":["gluten-free"],"main":"Chicken","servings":4,"rating":4.5,"ingredients":[{"name":"potato","text":"4 large potatoes, cubed"},{"name":"onion","text":"1 onion"},{"name":"garlic","text":"2 cloves garlic"},{"name":"chicken broth","text":"4 cups chicken broth"},{"name":"cream","text":"1/2 cup cream"},{"name":"cheddar","text":"shredded cheddar"},{"name":"bacon","text":"4 slices bacon"},{"name":"butter","text":"2 tbsp butter"}],"steps":["Crisp the bacon; crumble and set aside.","Soften onion and garlic in butter, add potatoes and broth; simmer 20 minutes.","Mash partially, stir in cream; top with cheddar and bacon."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-classic-beef-chili","title":"Classic Beef Chili","cuisine":"american","minutes":60,"difficulty":"medium","meals":["dinner","soup"],"vibes":["comfort-food","crowd-pleaser","meal-prep"],"diets":["gluten-free","dairy-free"],"main":"Beef","servings":6,"rating":4.6,"ingredients":[{"name":"ground beef","text":"500 g ground beef"},{"name":"kidney beans","text":"1 can kidney beans"},{"name":"canned tomatoes","text":"1 can crushed tomatoes"},{"name":"onion","text":"1 onion"},{"name":"garlic","text":"3 cloves garlic"},{"name":"chili powder","text":"2 tbsp chili powder"},{"name":"cumin","text":"1 tsp cumin"}],"steps":["Brown beef with onion and garlic.","Add spices, tomatoes and beans.","Simmer 40 minutes, stirring occasionally."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-spaghetti-bolognese","title":"Spaghetti Bolognese","cuisine":"italian","minutes":55,"difficulty":"medium","meals":["dinner"],"vibes":["comfort-food","crowd-pleaser"],"diets":[],"main":"Beef","servings":4,"rating":4.5,"ingredients":[{"name":"spaghetti","text":"400 g spaghetti"},{"name":"ground beef","text":"500 g ground beef"},{"name":"onion","text":"1 onion"},{"name":"carrot","text":"1 carrot"},{"name":"garlic","text":"2 cloves garlic"},{"name":"canned tomatoes","text":"1 can crushed tomatoes"},{"name":"parmesan","text":"parmesan, to serve"},{"name":"olive oil","text":"2 tbsp olive oil"}],"steps":["Soften finely chopped onion, carrot and garlic in oil.","Brown the beef, add tomatoes and simmer 30 minutes.","Serve over cooked spaghetti with parmesan."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-sheet-pan-sausage-and-potatoes","title":"Sheet-Pan Sausage and Potatoes","cuisine":"american","minutes":40,"difficulty":"easy","meals":["dinner"],"vibes":["weeknight","low-effort"],"diets":["gluten-free","dairy-free"],"main":"Pork","servings":3,"rating":4.3,"ingredients":[{"name":"sausage","text":"4 sausages"},{"name":"potato","text":"500 g baby potatoes"},{"name":"bell pepper","text":"2 bell peppers"},{"name":"onion","text":"1 onion"},{"name":"olive oil","text":"3 tbsp olive oil"}],"steps":["Toss chopped potatoes, peppers, onion and sausage with oil on a tray.","Roast at 220 C for 30 minutes, turning once."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-shakshuka","title":"Shakshuka","cuisine":"middle-eastern","minutes":30,"difficulty":"easy","meals":["breakfast","dinner"],"vibes":["breakfast-in-bed","date-night","sunday-morning"],"diets":["vegetarian","gluten-free","dairy-free"],"main":"Eggs","servings":2,"rating":4.7,"ingredients":[{"name":"egg","text":"4 eggs"},{"name":"canned tomatoes","text":"1 can crushed tomatoes"},{"name":"bell pepper","text":"1 bell pepper"},{"name":"onion","text":"1 onion"},{"name":"garlic","text":"2 cloves garlic"},{"name":"cumin","text":"1 tsp cumin"},{"name":"paprika","text":"1 tsp paprika"},{"name":"olive oil","text":"2 tbsp olive oil"}],"steps":["Soften onion and pepper in oil; add garlic and spices.","Add tomatoes and simmer 10 minutes.","Make wells, crack in eggs, cover and cook until set."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-tomato-soup","title":"Tomato Soup","cuisine":"american","minutes":30,"difficulty":"easy","meals":["lunch","soup"],"vibes":["comfort-food","workday-lunch"],"diets":["vegetarian","gluten-free"],"main":"Vegetables","servings":3,"rating":4.4,"ingredients":[{"name":"canned tomatoes","text":"1 large can tomatoes"},{"name":"onion","text":"1 onion"},{"name":"garlic","text":"2 cloves garlic"},{"name":"vegetable broth","text":"2 cups vegetable broth"},{"name":"cream","text":"1/4 cup cream"},{"name":"butter","text":"2 tbsp butter"}],"steps":["Soften onion and garlic in butter.","Add tomatoes and broth; simmer 15 minutes.","Blend smooth, stir in cream."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-garlic-butter-shrimp","title":"Garlic Butter Shrimp","cuisine":"american","minutes":15,"difficulty":"easy","meals":["dinner"],"vibes":["date-night","weeknight"],"diets":["pescatarian","gluten-free"],"main":"Fish & seafood","servings":2,"rating":4.6,"ingredients":[{"name":"shrimp","text":"300 g shrimp"},{"name":"butter","text":"3 tbsp butter"},{"name":"garlic","text":"4 cloves garlic"},{"name":"lemon","text":"1 lemon"},{"name":"parsley","text":"chopped parsley"},{"name":"chili flakes","text":"pinch of chili flakes"}],"steps":["Melt butter, cook garlic 30 seconds.","Add shrimp, cook 2 minutes per side.","Finish with lemon juice and parsley."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-chocolate-chip-cookies","title":"Chocolate Chip Cookies","cuisine":"american","minutes":30,"difficulty":"medium","meals":["dessert"],"vibes":["baking-day","crowd-pleaser"],"diets":["vegetarian"],"main":"Grains & baking","servings":12,"rating":4.8,"ingredients":[{"name":"flour","text":"2 1/4 cups flour"},{"name":"butter","text":"1 cup soft butter"},{"name":"sugar","text":"1/2 cup sugar"},{"name":"brown sugar","text":"3/4 cup brown sugar"},{"name":"egg","text":"2 eggs"},{"name":"vanilla","text":"2 tsp vanilla"},{"name":"baking soda","text":"1 tsp baking soda"},{"name":"chocolate chips","text":"2 cups chocolate chips"},{"name":"salt","text":"1 tsp salt"}],"steps":["Cream butter and both sugars; beat in eggs and vanilla.","Mix in flour, baking soda and salt, then chocolate chips.","Bake spoonfuls at 180 C for 10-12 minutes."],"source":{"name":"Cooking Hub sample recipe"}},{"id":"s-chocolate-mug-cake","title":"Chocolate Mug Cake","cuisine":"american","minutes":5,"difficulty":"easy","meals":["dessert"],"vibes":["late-night","low-effort"],"diets":["vegetarian"],"main":"Grains & baking","servings":1,"rating":4.0,"ingre